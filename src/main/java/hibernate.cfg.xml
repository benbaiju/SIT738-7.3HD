<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>

    <session-factory>

        <property name="hibernate.connection.driver_class">
            com.mysql.cj.jdbc.Driver
        </property>

        <property name="hibernate.connection.url">
            jdbc:mysql://localhost:3306/finsightdb
        </property>

        <property name="hibernate.connection.username">
            finsightadmin
        </property>

        <property name="hibernate.connection.password">
            finsightadmin
        </property>

        <property name="hibernate.connection.pool_size">
            1
        </property>

        <property name="hibernate.dialect">
            org.hibernate.dialect.MySQL8Dialect
        </property>

        <property name="hibernate.show_sql">
            true
        </property>

        <property name="hibernate.hbm2ddl.auto">
            update
        </property>

        <mapping class="edu.deakin.sit738.finsight.entity.User" />
        <mapping class="edu.deakin.sit738.finsight.entity.Expense" />
        <mapping class="edu.deakin.sit738.finsight.entity.Investment" />
        <mapping class="edu.deakin.sit738.finsight.entity.Loan" />
        <mapping class="edu.deakin.sit738.finsight.entity.FinancialGoal" />
        <mapping class="edu.deakin.sit738.finsight.entity.BankTransaction" />
        <mapping class="edu.deakin.sit738.finsight.entity.UploadedFile" />

    </session-factory>

</hibernate-configuration>